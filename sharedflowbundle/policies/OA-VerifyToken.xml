<?xml version="1.0" encoding="UTF-8"?>
<!--
  OAuthV2 – Verify Access Token
  Verifies the Bearer token against Apigee's token store.
  Scopes required are derived from the OpenAPI spec security requirements.
-->
<OAuthV2 async="false" continueOnError="false" enabled="true"
         name="OA-VerifyToken">
  <DisplayName>Verify OAuth2 Token</DisplayName>
  <Operation>VerifyAccessToken</Operation>
  <GenerateResponse enabled="false"/>
  
</OAuthV2>
