<?xml version="1.0" encoding="UTF-8"?>
<!--
  AssignMessage – Request Transformation
  Adds, removes, and modifies request headers before the
  request is forwarded to the backend target.
-->
<AssignMessage async="false" continueOnError="false" enabled="true"
               name="AM-RequestTransform">
  <DisplayName>Transform Request Headers</DisplayName>
  <AssignTo createNew="false" type="request"/>
  <Set>
    <Headers>
      <Header name="X-Forwarded-By">apigee-{apiproxy.name}</Header>
      <Header name="X-Request-Start">{system.timestamp}</Header>
    </Headers>
  </Set>
  <Remove>
    <Headers>
      <!-- Remove headers that should not reach the backend -->
      <Header name="Authorization"/>  <!-- Auth already verified upstream -->
      <Header name="x-forwarded-for"/>
      <Header name="x-forwarded-host"/>
      <Header name="x-forwarded-proto"/>
    </Headers>
  </Remove>
</AssignMessage>
