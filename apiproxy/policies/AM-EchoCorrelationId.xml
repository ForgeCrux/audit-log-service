<?xml version="1.0" encoding="UTF-8"?>
<AssignMessage async="false" continueOnError="false" enabled="true"
               name="AM-EchoCorrelationId">
  <DisplayName>Echo Correlation ID in Response</DisplayName>
  <AssignTo createNew="false" type="response"/>
  <Set>
    <Headers>
      <Header name="X-Correlation-Id">{request.header.x-correlation-id}</Header>
      <Header name="X-Request-Id">{messageid}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
